# Copie para `.env` (fora do git: confira que .env está no .gitignore) e preencha localmente.
# Aqui entram só valores NÃO sensíveis. Senhas e chaves vão em ./secrets/*.txt (ver compose.yaml).
APP_ENV=dev
APP_PORT=8080
LOG_LEVEL=info
POSTGRES_DB=app
POSTGRES_USER=app
# Gere as senhas assim (uma vez por máquina):
#   mkdir -p secrets && umask 077 && openssl rand -base64 32 > secrets/db_password.txt
#   openssl rand -base64 32 > secrets/redis_password.txt
